{
  "name": "personal-drive",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted personal Drive SaaS built with Next.js, PostgreSQL and Prisma",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
