# ============================================================
#  Configuración de PRODUCCIÓN para PersonalDrive
#  Copia este fichero como `.env` en el VPS antes de levantar
#  el stack:   cp .env.production.example .env  &&  nano .env
# ============================================================

# ---- Dominio y HTTPS (Caddy) ----
DOMAIN=drive.pablofuentes.org
ACME_EMAIL=tu-email@pablofuentes.org

# ---- Branding visible en la app y en la PWA ----
NEXT_PUBLIC_APP_NAME=PersonalDrive
NEXT_PUBLIC_APP_URL=https://drive.pablofuentes.org

# ---- Base de datos PostgreSQL ----
POSTGRES_USER=drive
POSTGRES_DB=drive
# Genera una contraseña fuerte:  openssl rand -base64 32
POSTGRES_PASSWORD=cambia-esta-contraseña-por-una-aleatoria

# ---- Autenticación ----
# Genera con:  openssl rand -base64 64
JWT_SECRET=cambia-esto-por-un-string-largo-aleatorio-de-al-menos-64-bytes
JWT_EXPIRES_IN=7d

# ---- Cuotas y límites de subida ----
# 10 GB por usuario por defecto
DEFAULT_QUOTA_BYTES=10737418240
# 2 GB de subida máxima por archivo
MAX_UPLOAD_BYTES=2147483648
# Debe ser ≥ MAX_UPLOAD_BYTES (Caddy entiende sufijos KB/MB/GB)
MAX_UPLOAD_SIZE=2GB

# ---- Roles ----
# Correos separados por coma que se promocionan a ADMIN al registrarse.
ADMIN_EMAILS=tu-email@pablofuentes.org
