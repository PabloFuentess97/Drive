# ============================================================
#  Variables de entorno – DESARROLLO LOCAL
#  Para producción, usa `.env.production.example`.
# ============================================================

# ---- Aplicación ----
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=PersonalDrive
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Base de datos (PostgreSQL local) ----
DATABASE_URL=postgresql://drive:drive@localhost:5432/drive?schema=public

# ---- Auth ----
# Genera con:  openssl rand -base64 64
JWT_SECRET=cambia-esto-en-tu-env-local
JWT_EXPIRES_IN=7d

# ---- Almacenamiento ----
STORAGE_DIR=./storage
DEFAULT_QUOTA_BYTES=10737418240   # 10 GB
MAX_UPLOAD_BYTES=2147483648       # 2 GB

# ---- Roles ----
ADMIN_EMAILS=
