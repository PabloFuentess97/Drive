# ---- Application ----
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=PersonalDrive
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Inside docker-compose use: postgresql://drive:drive@db:5432/drive?schema=public
DATABASE_URL=postgresql://drive:drive@localhost:5432/drive?schema=public

# ---- Auth ----
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-please-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Storage ----
# Absolute path on the VPS where files will be persisted.
STORAGE_DIR=/var/lib/personal-drive/uploads

# Default storage quota in bytes per user (10 GB).
DEFAULT_QUOTA_BYTES=10737418240

# Max single upload size in bytes (2 GB).
MAX_UPLOAD_BYTES=2147483648

# Comma-separated list of admin emails that get the ADMIN role on register.
ADMIN_EMAILS=
