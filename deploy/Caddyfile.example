# Drop this in /etc/caddy/Caddyfile or alongside docker-compose for an easy
# HTTPS-terminated reverse proxy. Replace drive.example.com with your domain.

drive.example.com {
    encode zstd gzip
    reverse_proxy localhost:3000

    # Allow large uploads (2 GB by default; adjust to your MAX_UPLOAD_BYTES).
    request_body {
        max_size 2GB
    }
}
